# Local demo only. No Google access; synthetic records only.
APP_MODE=demo
PORT=8080
APP_ORIGIN=http://localhost:5173
# For `npm run build` followed by `npm start`, use http://localhost:8080 instead.
# Live staging: APP_MODE=google and set all values below.
GOOGLE_CLIENT_ID=
GOOGLE_SHEETS_ID=
ALLOWED_DOMAINS=digiclarity.in,clarityrcm.com
# Copy the EXISTING value securely from Script Properties. Never generate a new
# pepper for existing passwords. Never commit this value or a service account key.
DGS_DASHBOARD_PASSWORD_PEPPER_V1=
# Configure both to the exact approved Cloud Run/Sheets owner identity after
# the Workspace administrators confirm the new hosting identity.
IAM_STORAGE_OWNER=
CLOUD_RUN_SERVICE_ACCOUNT_EMAIL=
# Live staging sessions are process-local in this milestone. One instance only.
# A distributed session store/lock is required before production release.
