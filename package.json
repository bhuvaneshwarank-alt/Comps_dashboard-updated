{
  "name": "digiclarity-cloud-migration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch server/src/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "test": "node --test server/test/*.test.js",
    "audit:source": "node scripts/source-audit.mjs"
  },
  "dependencies": {
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "google-auth-library": "11.3.1",
    "helmet": "8.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "vite": "8.3.5"
  }
}
